SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=sqlite:///db.sqlite3
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=
CSRF_TRUSTED_ORIGINS=

# Email verification and password recovery.
# Use "django" locally. Set "gmail_api" on Render.
EMAIL_PROVIDER=django
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=PhysioVision <no-reply@example.com>
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER_EMAIL=
GMAIL_SENDER_NAME=PhysioVision
EMAIL_VERIFICATION_CODE_TTL_MINUTES=10
EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_TOKEN_TTL_MINUTES=15
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_ATTEMPTS=5
AUTH_TOKEN_TTL_HOURS=12

# Automatic fall alerts. These settings call only a verified emergency contact;
# PhysioVision never dials 995. For a free Vonage demo, use 123456789 as the
# caller and set the allowed recipient to the number verified in Vonage.
EMERGENCY_ALERT_PROVIDER=disabled
VONAGE_APPLICATION_ID=
# Paste the complete Vonage private key, including BEGIN/END lines. Render also
# accepts this as a multiline secret value.
VONAGE_PRIVATE_KEY=
VONAGE_FROM_NUMBER=123456789
VONAGE_DEMO_MODE=True
VONAGE_DEMO_TO_NUMBER=
EMERGENCY_ALERT_DELAY_SECONDS=60
EMERGENCY_CONTACT_VERIFICATION_TTL_MINUTES=10
EMERGENCY_CONTACT_VERIFICATION_COOLDOWN_SECONDS=60
EMERGENCY_CONTACT_VERIFICATION_MAX_ATTEMPTS=5

# Slack Physio Assistant AI
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
# Channel for alerts about patients with no linked clinician (bot must be a member).
SLACK_TRIAGE_CHANNEL_ID=
# Shareable workspace invite link (from Slack → Invite people) shown to clinicians.
SLACK_WORKSPACE_INVITE_URL=https://join.slack.com/t/physiovisionworkspace/shared_invite/zt-44o3hknr9-D6A~LeWF7qcEqWOnxsJ39g

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_TTS_VOICE=Sulafat

# Frontend URL (used in Slack alert deep links)
FRONTEND_URL=http://localhost:4173
